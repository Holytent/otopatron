{"hero": "<div class=\"loading-scene\" aria-label=\"Gece aydınlatılmış galeri\"><img class=\"loading-gallery\" src=\"data:image/svg+xml;base64,\" alt=\"\"><div class=\"loading-road\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"></div><span class=\"loading-sign\">OTOPATRON</span></div>", "css": "#launch{background:radial-gradient(ellipse at 50% 35%,#223747,#0d1625 75%);color:#f4f7fb;padding:18px 20px 65px}.card{max-width:460px}.logo{width:48px;height:48px;border-radius:13px;margin:0 auto 12px}.logo img{width:48px;height:48px;border-radius:13px}h1{font-size:28px}.subtitle{color:#e6687a}#message{color:#c5d0dd}.credits{color:#b1bfcc}#message.error{color:#ff9baa}.loading-scene{position:relative;width:100%;height:215px;border-radius:20px;overflow:hidden;background:#12263d;box-shadow:0 18px 40px #0005;margin-bottom:20px}.loading-gallery{width:100%;height:205px;object-fit:cover;object-position:center}.loading-road{position:absolute;bottom:0;height:48px;background:#263647;width:100%;border-top:2px solid #7593a5}.loading-road:before{content:\"\";position:absolute;left:0;right:0;top:32px;height:2px;background:repeating-linear-gradient(90deg,#a5b6c7 0 25px,transparent 25px 55px)}.loading-road img{position:absolute;width:105px;height:52px;object-fit:contain;top:-8px;animation:lobby-traffic 9s linear infinite;will-change:transform}.loading-sign{position:absolute;top:55px;left:20%;right:20%;font-size:12px;line-height:24px;letter-spacing:1px;background:#22465c;color:#f4f7fc;border:1px solid #6e93a4} @keyframes lobby-traffic{from{transform:translateX(-130px)}to{transform:translateX(570px)}}\n@media(max-height:600px){.loading-scene{height:155px;margin-bottom:10px}.loading-gallery{height:155px}.loading-sign{top:31px}.logo{display:none}h1{font-size:24px}#message{margin:8px 0}}\n"}